# Environment
NODE_ENV=development

# Database
DATABASE_URL=postgresql://eldercare:eldercare_dev_password@localhost:5432/eldercare_dev

# Redis/Valkey
REDIS_URL=redis://localhost:6379

# JWT — three separate secrets per AGENTS.md Rule 3 ("No shared secret across purposes")
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_me_refresh_secret_at_least_32_chars
JWT_PAIRING_SECRET=replace_me_pairing_secret_at_least_32_chars

# Token TTLs
JWT_ACCESS_TTL=8h
JWT_REFRESH_TTL=30d
JWT_PAIRING_TTL=15m

# Bcrypt cost factor (work factor; 12 ~ 250ms hash on a modern CPU)
BCRYPT_ROUNDS=12

# Firebase
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-credentials.json

# Google OAuth Client ID (from Firebase Console → Authentication → Sign-in method → Google)
GOOGLE_CLIENT_ID=

# Email — two transport options (pick ONE):
#
# Option A (recommended for DigitalOcean / cloud VMs where SMTP ports are blocked):
#   Sign up at https://resend.com (free: 100 emails/day), create an API key.
#   Uses HTTPS (port 443) — no SMTP port restrictions.
RESEND_API_KEY=
#
# Option B (local dev / hosts with open SMTP ports):
#   Gmail: create an App Password
#   (Google Account → Security → 2-Step Verification → App passwords).
#   If SMTP_USER/SMTP_PASS are left blank AND RESEND_API_KEY is blank,
#   verification emails are skipped (no-op) — registration is never blocked.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=eldercare.noreply@gmail.com
SMTP_PASS=
MAIL_FROM=ElderCare <eldercare.noreply@gmail.com>



# Public URL of the caregiver web app — used to build the verification link
# (${WEB_APP_URL}/verify-email?token=...). Dev default: http://localhost:3001
WEB_APP_URL=http://localhost:3001

# Demo only: comma-separated elder UUIDs auto-linked to EVERY new caregiver on
# registration, so shared demo profiles appear in every account. Leave empty for
# the normal product flow (caregivers pair their own elders).
DEMO_ELDER_IDS=

# Google Gemini AI
GEMINI_API_KEY=

# NestJS App
APP_PORT=3000
APP_HOST=0.0.0.0

# Logging
LOG_LEVEL=debug
